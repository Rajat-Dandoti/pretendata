{
  "name": "pretendata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generate synthetic, privacy-safe test data (checksum-valid IDs, DLP false-positive controls, compliance tagging) for QA and DLP/DSPM testing.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/lib/_selftest.ts",
    "server": "tsx watch server/index.ts",
    "dev:all": "tsx watch server/index.ts & vite --port=3000 --host=0.0.0.0; kill $!"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "hono": "^4.12.27",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamsaver": "^2.0.6",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/streamsaver": "^2.0.5",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
