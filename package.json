{
  "name": "pretendata",
  "version": "1.0.0",
  "description": "Synthetic test data with a known answer key, for testing DLP, DSPM, data classification, secret scanning and masking tools. Checksum-valid identifiers, deliberate near-misses, and scoring.",
  "keywords": [
    "synthetic-data",
    "test-data",
    "dlp",
    "dspm",
    "pii",
    "phi",
    "pci",
    "data-classification",
    "privacy",
    "secret-scanning",
    "masking",
    "anonymization",
    "aadhaar",
    "benchmark"
  ],
  "homepage": "https://pretendata.voidkit.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajat-Dandoti/pretendata.git"
  },
  "bugs": {
    "url": "https://github.com/Rajat-Dandoti/pretendata/issues"
  },
  "license": "MIT",
  "author": "Rajat Dandoti",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pretendata": "dist-cli/pretendata.js"
  },
  "files": [
    "dist-cli",
    "README.md",
    "COLUMNS.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/lib/_selftest.ts",
    "server": "tsx watch server/index.ts",
    "dev:all": "tsx watch server/index.ts & vite --port=5173 --host=0.0.0.0; kill $!",
    "smoke": "vite build && node smoke/run.mjs",
    "pin-seed": "tsx src/lib/_seedcontract.ts",
    "cli": "tsx bin/pretendata.ts",
    "build:cli": "vite build -c vite.cli.config.ts",
    "build:reference": "tsx scripts/build-reference.ts",
    "build:offline": "vite build -c vite.offline.config.ts && tsx scripts/inline-offline.ts",
    "crosscheck": "node scripts/crosscheck/run.mjs",
    "prepack": "npm run build:cli"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@hono/node-server": "^2.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/streamsaver": "^2.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "hono": "^4.12.27",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamsaver": "^2.0.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
